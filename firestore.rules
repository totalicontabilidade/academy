rules_version = '2';

// ============================================================
// Totali · Academy — regras do Firestore
//
// A Academy é um sistema de VÍDEOS. Não guarda documento, senha,
// dado de empresa nem arquivo de cliente — tudo isso saiu em
// 23/09/2026, quando o onboarding virou um sistema à parte (ver a
// tag `portal-completo` no git). Sobrou o essencial:
//
//   conteudo/{doc}     o catálogo de trilhas e aulas que a equipe publica
//   usuarios/{uid}     quem é da equipe, e quem é administrador
//   alunos/{uid}       quem assiste, e o que já assistiu
//   convites/{codigo}  os links que dão acesso
//
// O DADO MAIS SENSÍVEL AQUI É O NOME DE QUEM ASSISTE. Não há
// documento fiscal, não há senha de terceiro, não há valor. Isso
// muda o desenho das regras: elas ficam curtas porque há pouco a
// proteger, e não porque alguém relaxou.
//
// O QUE NÃO MUDOU do sistema antigo, porque funcionou:
// a existência de `usuarios/{uid}` é o que prova ser da equipe, e
// toda gravação da equipe vem assinada com o próprio uid.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Ser da equipe é TER DOCUMENTO em /usuarios. Não é um campo
    // no próprio perfil, que a pessoa poderia escrever: é um
    // documento que só administrador cria.
    function ehEquipe() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function ehAdmin() {
      return ehEquipe() &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin';
    }

    // Assinatura, não declaração de boa fé: o `porUid` gravado tem
    // de ser o uid de quem está gravando.
    function assinado() {
      return request.resource.data.get('porUid', request.auth.uid) == request.auth.uid;
    }

    function soEstes(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function soEstesAoCriar(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }

    function texto(valor, max) {
      return valor is string && valor.size() <= max;
    }

    // ------------------------------------------------------------
    // O CATÁLOGO
    //
    // Leitura aberta de propósito: é o conteúdo do produto, e a
    // tela de entrada precisa mostrar o nome e o contato da Totali
    // antes de qualquer login. Nada aqui é de cliente.
    // ------------------------------------------------------------
    match /conteudo/{doc} {
      allow get: if true;
      allow list: if ehEquipe();
      allow write: if ehEquipe();
    }

    // ------------------------------------------------------------
    // A EQUIPE
    //
    // O PRIMEIRO ADMINISTRADOR NASCE NO CONSOLE, à mão. Não há
    // como uma regra dizer "pode se promover se a coleção estiver
    // vazia" sem abrir a porta para quem chegar primeiro, e num
    // projeto novo quem chega primeiro pode ser qualquer um.
    // ------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if ehEquipe();
      allow create, update: if ehAdmin() && assinado();
      allow delete: if ehAdmin();
    }

    // ------------------------------------------------------------
    // QUEM ASSISTE
    //
    // O aluno escreve o próprio documento e mais nada. O
    // `progresso` é dele: marcar aula como vista é gravação de
    // aluno, e por isso ele pode mexer nesse campo.
    //
    // `papel` NÃO existe aqui de propósito. Se existisse, o aluno
    // poderia se escrever como equipe — e a prova de ser equipe
    // seria um campo que o próprio interessado controla. A prova
    // mora em /usuarios, que ele não alcança.
    // ------------------------------------------------------------
    match /alunos/{uid} {
      allow get: if ehEquipe() || (logado() && request.auth.uid == uid);
      allow list: if ehEquipe();

      // No cadastro, o aluno prova que foi convidado: o código tem
      // de existir e estar ativo. Sem isso, qualquer um com o
      // endereço criaria conta e assistiria tudo.
      allow create: if logado() && request.auth.uid == uid
                    && soEstesAoCriar(['nome', 'email', 'empresa', 'convite',
                                       'criadoEm', 'ultimoAcessoEm', 'progresso'])
                    && texto(request.resource.data.nome, 120)
                    && texto(request.resource.data.convite, 40)
                    && exists(/databases/$(database)/documents/convites/$(request.resource.data.convite))
                    && get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.ativo == true;

      allow update: if ehEquipe()
                    || (logado() && request.auth.uid == uid
                        && soEstes(['nome', 'empresa', 'ultimoAcessoEm', 'progresso']));

      // Apagar a própria conta é direito dele (LGPD). A equipe
      // também pode, a pedido.
      allow delete: if ehEquipe() || (logado() && request.auth.uid == uid);
    }

    // ------------------------------------------------------------
    // OS CONVITES
    //
    // `get` é aberto porque quem chega pelo link ainda não tem
    // conta e precisa validar o código antes de criar a senha. Só
    // que `get` exige SABER o código: sem ele não há o que ler.
    // `list` fica fechado justamente para ninguém varrer a coleção
    // e sair com todos os códigos.
    // ------------------------------------------------------------
    match /convites/{codigo} {
      allow get: if true;
      allow list: if ehEquipe();
      allow create, update: if ehEquipe() && assinado();
      allow delete: if ehEquipe();
    }

    // Nada mais existe. O que não está escrito acima está negado,
    // e é assim que se percebe que sobrou coisa velha apontando
    // para cá: a gravação falha em vez de passar calada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
