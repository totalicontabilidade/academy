rules_version = '2';

// ============================================================
// A CONSULTA ENTRE SERVICOS PRECISA SER LIBERADA UMA VEZ
//
// O `firestore.exists(...)` logo abaixo e o que faz esta regra
// saber quem e da equipe. Ele so funciona depois de o projeto
// receber a permissao para consultar o Firestore a partir do
// Storage, e essa permissao NAO vem junto quando as regras sao
// publicadas pela linha de comando.
//
// Enquanto faltar, a regra reprova TODO envio em silencio: o
// navegador recebe storage/unauthorized e as regras parecem
// certas, porque estao. Aconteceu em 23/09/2026.
//
// Como resolver: console do Firebase -> Storage -> Rules. A
// faixa vermelha no alto traz o botao Corrigir problema.
//
// E DEPOIS DE CONCEDER, PUBLIQUE AS REGRAS DE NOVO. So a
// permissao nao basta: foi preciso subir uma versao nova para
// o envio passar a funcionar. Se o `firebase deploy` disser
// "already up to date, skipping upload", mude qualquer
// comentario aqui para forcar o envio.
// ============================================================


// ============================================================
// Totali · Academy — regras do Storage
//
// Aqui vive UMA coisa só: o material das aulas que a equipe
// publica — a capa da trilha, o áudio para o cliente ouvir no
// carro e o PDF de acompanhamento. O vídeo em si está no YouTube
// e não passa por aqui.
//
// NÃO EXISTE MAIS ARQUIVO DE CLIENTE. Toda a pasta
// `empresas/{id}/...`, com documento, anexo de conversa e termo
// assinado, saiu em 23/09/2026 junto com o onboarding (ver a tag
// `portal-completo` no git). O que sobrou é conteúdo nosso, igual
// para todo mundo, e por isso a leitura é pública.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function ehEquipe() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    match /publico/{arquivo=**} {
      // O endereço de cada arquivo é sorteado, não adivinhável, e
      // o conteúdo é o material do curso. Ler é de todos.
      allow read: if true;

      // CREATE E DELETE SEPARADOS, e o motivo é uma armadilha que
      // já custou tempo neste projeto: `allow write` cobre também
      // a EXCLUSÃO, e numa exclusão não existe `request.resource`
      // — então qualquer condição de tamanho reprovava, e a equipe
      // nunca conseguia apagar nada.
      //
      // Limites por tipo, e não um teto único: imagem acima de
      // 5 MB é capa mal exportada, mas uma aula em áudio passa
      // fácil de 20 MB.
      //
      // HTML, SVG e executável ficam fora. Esta pasta é servida
      // com leitura pública, e arquivo que o navegador EXECUTA
      // servido do nosso endereço é XSS com a nossa assinatura.
      allow create, update: if ehEquipe()
                            && (
                              (request.resource.size <= 5 * 1024 * 1024
                               && request.resource.contentType.matches('image/(jpeg|png|webp)'))
                              ||
                              (request.resource.size <= 60 * 1024 * 1024
                               && request.resource.contentType.matches(
                                    'audio/(mpeg|mp3|mp4|x-m4a|aac|ogg|opus|wav|x-wav)'))
                              ||
                              (request.resource.size <= 60 * 1024 * 1024
                               && request.resource.contentType == 'application/pdf')
                            );
      allow delete: if ehEquipe();
    }

    match /{tudo=**} {
      allow read, write: if false;
    }
  }
}
